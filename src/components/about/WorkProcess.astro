---
import StickyTitle from "@components/ui/StickyTitle.astro";
import type es from "@i18n/ui/es";

interface Props {
  texts: typeof es.about.process;
}

const { texts: t } = Astro.props;
---

<section
  class="relative flex w-full flex-col items-center gap-20 md:gap-32 lg:gap-52"
>
  <StickyTitle title={t.title} simple button="" to="" />
  <div
    class="relative flex w-full flex-col items-center gap-20 px-4 md:gap-24 md:px-8 lg:gap-36"
  >
    <p
      class="observe-enter max-w-2xl text-center text-sm/relaxed font-medium text-balance opacity-0 md:text-base/relaxed lg:max-w-3xl lg:text-xl/relaxed"
    >
      {t.texts}
    </p>
    <div
      class="flex w-full max-w-6xl flex-wrap items-center justify-center gap-9"
    >
      {
        t.process.map(({ step, label, description }, index) => (
          <div
            class="group observe-enter relative flex min-h-52 w-full flex-col items-center justify-center gap-2.5 overflow-hidden rounded-sm border border-neutral-800/80 bg-neutral-950 p-4 opacity-0 transition-all duration-300 ease-in-out md:h-44 md:w-80 md:hover:scale-110 md:hover:bg-neutral-800/80"
            style={`animation-delay: ${index * 150}ms`}
          >
            <div class="flex flex-col items-center justify-center text-center uppercase duration-300 md:size-full md:group-hover:-translate-y-full">
              <h3 class="font-mono text-5xl font-medium md:text-8xl">{step}</h3>
              <p class="text-base font-medium text-neutral-400 md:text-lg/tight">
                {label}
              </p>
            </div>
            <p class="mt-2 text-center text-sm font-normal text-neutral-300 max-md:max-w-xs md:absolute md:mt-0 md:flex md:size-full md:translate-y-full md:items-center md:justify-center md:p-4 md:text-xl/tight md:font-medium md:text-white md:duration-300 md:group-hover:translate-y-0">
              {description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
